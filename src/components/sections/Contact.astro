---
import { site } from '@config/site';
import { useTranslations } from '@i18n';
const en = useTranslations('en'); const es = useTranslations('es');
---

<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <div class="page-container contact-inner">
    <div>
      <p class="section-kicker" data-copy-en={en.contact.kicker} data-copy-es={es.contact.kicker}>{en.contact.kicker}</p>
      <h2 id="contact-title" class="contact-title" data-copy-en={en.contact.title} data-copy-es={es.contact.title}>{en.contact.title}</h2>
    </div>
    <div>
      <p class="contact-copy" data-copy-en={en.contact.copy} data-copy-es={es.contact.copy}>{en.contact.copy}</p>
      <div class="text-actions">
        <a class="text-link" href={`mailto:${site.contactEmail}`}><span data-copy-en={en.contact.email} data-copy-es={es.contact.email}>{en.contact.email}</span> <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={site.linkedInUrl}>LinkedIn <span aria-hidden="true">↗</span></a>
        {site.githubUrl && <a class="text-link" href={site.githubUrl}>GitHub <span aria-hidden="true">↗</span></a>}
      </div>
    </div>
  </div>
</section>

---
import { site } from '@config/site';
import { useTranslations } from '@i18n';
const en = useTranslations('en'); const es = useTranslations('es');

const [givenName, ...familyName] = site.fullName.split(' ');
---

<section class="page-container hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero-title">
    <span>{givenName}</span>
    <span class="surname">{familyName.join(' ')}</span>
  </h1>
  <div class="hero-bottom">
    <p class="hero-role"><span data-copy-en={en.hero.role} data-copy-es={es.hero.role}>{en.hero.role}</span><br /><span data-copy-en={en.hero.based} data-copy-es={es.hero.based}>{en.hero.based}</span></p>
    <div>
      <p class="hero-intro" data-copy-en={en.hero.intro} data-copy-es={es.hero.intro}>{en.hero.intro}</p>
      <p class="hero-availability" data-copy-en={en.hero.availability} data-copy-es={es.hero.availability}>{en.hero.availability}</p>
      <div class="text-actions">
        <a class="text-link" href="#work"><span data-copy-en={en.hero.selectedWork} data-copy-es={es.hero.selectedWork}>{en.hero.selectedWork}</span> <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={site.resume.url} hreflang="en"><span data-copy-en={en.hero.resume} data-copy-es={es.hero.resume}>{en.hero.resume}</span><span aria-hidden="true">↗</span></a>
        <a class="text-link" href={site.linkedInUrl}>LinkedIn <span aria-hidden="true">↗</span></a>
        {site.githubUrl && <a class="text-link" href={site.githubUrl}>GitHub <span aria-hidden="true">↗</span></a>}
      </div>
    </div>
  </div>
</section>

---
import PageLayout from '@layouts/PageLayout.astro';
import { getExperience } from '@data/experience';
import { useTranslations } from '@i18n';
import { site } from '@config/site';
import { publishedProjects } from '@lib/content';
const projects = await publishedProjects('en');
const experience = getExperience('en'); const spanish = getExperience('es');
const en = useTranslations('en'); const es = useTranslations('es');
---
<PageLayout title="Experience" localizedTitle="Experiencia" description="Johnny Canelones' software engineering experience across aviation, environmental data, financial systems, and media." localizedDescription="Experiencia de Johnny Canelones en ingeniería de software para aviación, datos ambientales, sistemas financieros y medios.">
 <div class="page-container editorial-page"><header class="article-header"><p class="section-kicker" data-copy-en={en.experience.pageKicker} data-copy-es={es.experience.pageKicker}>{en.experience.pageKicker}</p><h1 data-copy-en={en.experience.title} data-copy-es={es.experience.title}>{en.experience.title}</h1><p class="article-deck" data-copy-en={en.experience.pageDeck} data-copy-es={es.experience.pageDeck}>{en.experience.pageDeck}</p><a class="text-link" href={site.resume.url} hreflang="en"><span data-copy-en={en.experience.downloadResume} data-copy-es={es.experience.downloadResume}>{en.experience.downloadResume}</span> ↗</a></header>
 <div class="experience-list">{experience.map((entry,index) => <article class="experience-item"><p class="experience-period" data-copy-en={entry.period} data-copy-es={spanish[index].period}>{entry.period}</p><div><h2 class="experience-heading">{entry.company}</h2><p class="experience-role" data-copy-en={entry.role} data-copy-es={spanish[index].role}>{entry.role}</p><p class="experience-description" data-copy-en={entry.summary} data-copy-es={spanish[index].summary}>{entry.summary}</p>{entry.detail && <p class="experience-description" data-copy-en={entry.detail} data-copy-es={spanish[index].detail ?? ''}>{entry.detail}</p>}<p class="experience-tech">{entry.technologies}</p>{projects.filter(p=>p.data.experienceId===entry.id).map(p=><a class="text-link" href={`/projects/${p.data.slug}/`}><span data-copy-en={`Read ${p.data.title} case study`} data-copy-es={`Leer el caso de ${p.data.title}`}>Read {p.data.title} case study</span> ↗</a>)}</div></article>)}</div></div>
</PageLayout>

---
import { publishedProjects } from '@lib/content';
import Footer from '@components/layout/Footer.astro';
import Header from '@components/layout/Header.astro';
import About from '@components/sections/About.astro';
import Contact from '@components/sections/Contact.astro';
import Experience from '@components/sections/Experience.astro';
import Expertise from '@components/sections/Expertise.astro';
import Hero from '@components/sections/Hero.astro';
import SelectedWork from '@components/sections/SelectedWork.astro';
import { site } from '@config/site';
import BaseLayout from '@layouts/BaseLayout.astro';

const projects = await publishedProjects('en');
const projectTranslations = await publishedProjects('es');
---

<BaseLayout noindex={site.url === 'https://example.com'}>
  <Header />
  <main id="main-content" class="with-fixed-header">
    <Hero />
    <SelectedWork projects={projects} translations={projectTranslations} />
    <Experience />
    <Expertise />
    <About />
    <Contact />
  </main>
  <Footer />
</BaseLayout>

<script>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  if ('IntersectionObserver' in window && 'animate' in Element.prototype && !reducedMotion.matches) {
    const activeAnimations = new Set<Animation>();
    const prepared = new WeakMap<Element, Animation>();
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        prepared.get(entry.target)?.play();
      }
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0 });

    document.querySelectorAll<HTMLElement>('main h2, .feature-shot img, .gallery-slide:first-child img, .about-portrait').forEach((element) => {
      // Never hide content already visible, including restored scroll positions.
      if (element.getBoundingClientRect().top < innerHeight) return;
      const isImage = element instanceof HTMLImageElement;
      const animation = element.animate(
        isImage
          ? [{ clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0% 0 0)' }]
          : [
              { clipPath: 'inset(0 0 100% 0)', transform: 'translateY(16px)' },
              { clipPath: 'inset(0 0 0% 0)', transform: 'translateY(0)' },
            ],
        { duration: isImage ? 850 : 650, fill: 'both', easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
      );
      // Hold the first frame while offscreen, then play the same animation on entry.
      animation.pause();
      animation.currentTime = 0;
      prepared.set(element, animation);
      activeAnimations.add(animation);
      const finishOnFocus = () => {
        observer.unobserve(element);
        animation.cancel();
      };
      element.addEventListener('focus', finishOnFocus, { once: true });
      const cleanup = () => {
        activeAnimations.delete(animation);
        prepared.delete(element);
        element.removeEventListener('focus', finishOnFocus);
      };
      animation.finished.then(() => {
        cleanup();
        animation.cancel();
      }, cleanup);
      observer.observe(element);
    });
    reducedMotion.addEventListener('change', () => {
      if (!reducedMotion.matches) return;
      observer.disconnect();
      activeAnimations.forEach((animation) => animation.cancel());
    });
  }
</script>

---
import { site } from '@config/site';
import { t } from '../i18n';
import BaseLayout from '@layouts/BaseLayout.astro';

const colors = [
  ['Background', 'var(--background)'],
  ['Surface', 'var(--surface)'],
  ['Elevated', 'var(--surface-elevated)'],
  ['Muted', 'var(--muted)'],
  ['Primary', 'var(--primary)'],
  ['Accent', 'var(--accent)'],
  ['Success', 'var(--success)'],
  ['Warning', 'var(--warning)'],
  ['Error', 'var(--error)'],
] as const;
---

<BaseLayout title={t('en', 'foundationLabel')} noindex>
  <div class="preview-shell">
    <p class="font-mono text-sm text-accent">{t('en', 'foundationLabel')} / 01</p>
    <header class="max-w-3xl py-12">
      <h1 class="text-5xl font-semibold tracking-tight md:text-7xl">{site.fullName}</h1>
      <p class="mt-6 text-xl text-muted-foreground">{site.professionalTitle}</p>
      <p class="mt-3 text-base text-muted-foreground">{t('en', 'foundationDescription')}</p>
    </header>

    <section aria-labelledby="typography-heading" class="border-t border-border py-12">
      <h2 id="typography-heading" class="mb-6 text-sm font-semibold uppercase tracking-widest text-muted-foreground">
        {t('en', 'typography')}
      </h2>
      <div class="preview-grid">
        <div class="preview-card">
          <p class="text-3xl font-semibold tracking-tight">Geist Sans</p>
          <p class="mt-3 text-muted-foreground">The quick brown fox jumps over the lazy dog.</p>
        </div>
        <div class="preview-card font-mono">
          <p class="text-xl">Geist Mono</p>
          <p class="mt-3 text-sm text-muted-foreground">0123456789 / =&gt; const foundation = true;</p>
        </div>
      </div>
    </section>

    <section aria-labelledby="colors-heading" class="border-t border-border py-12">
      <h2 id="colors-heading" class="mb-6 text-sm font-semibold uppercase tracking-widest text-muted-foreground">
        {t('en', 'colors')}
      </h2>
      <div class="preview-grid">
        {colors.map(([label, value]) => (
          <div class="preview-card">
            <div class="preview-swatch" style={`background: ${value}`} aria-hidden="true"></div>
            <p class="mt-3 text-sm font-medium">{label}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="surfaces-heading" class="border-t border-border py-12">
      <h2 id="surfaces-heading" class="mb-6 text-sm font-semibold uppercase tracking-widest text-muted-foreground">
        {t('en', 'surfaces')}
      </h2>
      <div class="preview-card max-w-2xl shadow-lg">
        <p class="text-lg font-medium">Surface, border, and elevation</p>
        <p class="mt-2 text-muted-foreground">{t('en', 'themeHint')}</p>
        <div class="mt-6 rounded-md border border-border bg-surface-elevated p-4 text-sm">Elevated surface</div>
      </div>
    </section>
  </div>
</BaseLayout>

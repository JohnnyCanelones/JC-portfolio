{
  "name": "portfolio-foundation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "biome check --formatter-enabled=false .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "validate": "pnpm format:check && pnpm lint && pnpm check && pnpm build && pnpm test",
    "test": "node --test scripts/content-policy.test.mjs scripts/certifications/certifications.test.ts && python3 scripts/check-output.py",
    "test:certifications": "node --test scripts/certifications/certifications.test.ts",
    "sync:platzi": "node scripts/certifications/sync-platzi.ts",
    "test:publishing": "python3 scripts/check-publication.py"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.6",
    "@astrojs/react": "7.1.9",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "lucide-react": "1.79.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.6.9",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "6.0.3"
  }
}
